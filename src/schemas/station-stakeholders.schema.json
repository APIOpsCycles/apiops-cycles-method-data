{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["stationStakeholdersByCycle"],
  "additionalProperties": false,
  "properties": {
    "stationStakeholdersByCycle": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["stakeholder", "involvement"],
            "additionalProperties": false,
            "properties": {
              "stakeholder": { "type": "string" },
              "involvement": {
                "type": "string",
                "enum": ["lead", "core", "consulted"]
              },
              "responsibilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["resource", "role"],
                  "additionalProperties": false,
                  "properties": {
                    "resource": { "type": "string" },
                    "role": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
